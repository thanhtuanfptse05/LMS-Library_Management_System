@startuml LoginEmailPasswordFlow
skinparam activity {
  BackgroundColor White
  BorderColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
}
skinparam ArrowColor Black
skinparam titleBorderThickness 1
skinparam titleBorderColor Black
skinparam titleBackgroundColor White
title Email/Password Login Flow

|User|
start
:Submit email & password;

|System|
:Authenticate user credentials\n& check account eligibility;

if (Credentials valid & account eligible?) then (No)
  :Display authentication / account status error;
  |User|
  :View error message;
  |System|
else (Yes)
  :Establish user session\n& determine dashboard access;
  |User|
  :Access role dashboard;
  |System|
endif

|System|
stop
@enduml
