@startuml Flow_5_2_GiaHanSachTrucTuyen
autoactivate on

actor User
participant "my-borrowings.jsp" as JSP
participant "AuthFilter" as Filter
participant "RenewalServlet" as Servlet
participant "OnlineCirculationService" as Service
participant "BorrowRecordDAO" as BRDAO
participant "ReservationDAO" as ResvDAO
participant "SystemConfigDAO" as ConfigDAO
participant "AuditLogDAO" as AuditDAO
participant "EmailService" as Email

User -> JSP : 1 : click "Gia hạn" trên phiếu mượn
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response)
return
Servlet -> Service : 4 : renewBook(userId, borrowRecordId, role)
Service -> BRDAO : 4.1 : findById(conn, borrowRecordId)
return
Service -> ConfigDAO : 4.2 : getValue("RENEWAL_MIN_DAYS_BEFORE_DUE")
return
Service -> ConfigDAO : 4.3 : getValue("MAX_EXTENSION_COUNT")
return
Service -> ConfigDAO : 4.4 : getValue("STUDENT_MAX_BORROW_DAYS")
return

alt 4a [Điều kiện 1 sai - chưa đủ thời gian tối thiểu - BR-21]
    Service --> Servlet : throw ValidationException\n("Chưa đủ thời gian để gia hạn")
    Servlet --> JSP : set errorMessage, forward

else 4b [Điều kiện 2 sai - extensionCount >= MAX_EXTENSION_COUNT]
    Service --> Servlet : throw ValidationException\n("Đã hết lượt gia hạn ({MAX} lần)")
    Servlet --> JSP : set errorMessage, forward

else 4c [kiểm tra Điều kiện 3 - có ai xếp hàng chờ?]
    Service -> ResvDAO : 4.5 : hasActivePendingQueue(conn, bookId)

    alt 4c.1 [có người đang chờ - BR-21]
        ResvDAO --> Service : return true
        Service --> Servlet : throw ValidationException\n("Có người đang chờ sách này")
        Servlet --> JSP : forward

    else 4c.2 [tất cả điều kiện OK]
        note over Service : BEGIN Transaction
        Service -> BRDAO : 5 : extendBorrowRecord\n(conn, borrowRecordId,\nnewEndDate, extensionCount+1)
        note right : UPDATE BorrowRecord\nSET endDate=endDate+LoanDays\nextensionCount=extensionCount+1
        return
        Service -> AuditDAO : 5.1 : insertAuditLog(userId,\n"RENEW_BOOK_ONLINE",\n"BorrowRecord", borrowRecordId, ...)
        return
        note over Service : COMMIT Transaction
        Service -> Email : 5.2 : enqueue(RENEWAL_CONFIRMATION,\nuserId, {newEndDate})
        note right : Bất đồng bộ
        return
        Service --> Servlet : return newEndDate
        Servlet -> User : 6 : flash "Gia hạn thành công!\nHạn mới: {newEndDate}"
    end
end
@enduml
