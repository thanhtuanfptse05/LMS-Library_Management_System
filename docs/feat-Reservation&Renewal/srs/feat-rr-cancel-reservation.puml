@startuml Flow_5_3_HuyDatTruocTrucTuyen
autoactivate on

actor User
participant "my-borrowings.jsp" as JSP
participant "AuthFilter" as Filter
participant "CancelReservationServlet" as Servlet
participant "OnlineCirculationService" as Service
participant "ReservationDAO" as ResvDAO
participant "BookCopyDAO" as BCDAO
participant "BookDAO" as BDAO
participant "AuditLogDAO" as AuditDAO
participant "EmailService" as Email

User -> JSP : 1 : click "Hủy đặt trước"
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response)
return
Servlet -> Service : 4 : cancelReservation(userId, reservationId)
Service -> ResvDAO : 4.1 : findById(conn, reservationId)
return

alt 4.1a [không tồn tại hoặc không thuộc userId]
    ResvDAO --> Service : return null / userId mismatch
    Service --> Servlet : throw ValidationException\n("Không có quyền hủy")
    Servlet --> JSP : set errorMessage 403, forward

else 4.1b [hợp lệ]
    note over Service : BEGIN Transaction
    Service -> ResvDAO : 4.2 : cancelReservation\n(conn, reservationId, cancelledAt=NOW())
    return

    alt 4.2a [Reservation.status = 'readypickup' - đang giữ bản sao]
        Service -> ResvDAO : 4.3 : findNextInQueue(conn, bookId)

        alt 4.3a [có người tiếp theo trong hàng chờ]
            ResvDAO --> Service : return nextReservation
            Service -> ResvDAO : 4.4 : promoteToReadyPickup\n(nextReservationId, bookCopyId,\nendDate=NOW()+HOLD_DAYS)
            return
            Service -> BCDAO : 4.5 : updateStatus(bookCopyId, 'reserved')
            return
            Service -> Email : 4.6 : enqueue(RESERVATION_READY, nextUserId)
            note right : Bất đồng bộ
            return

        else 4.3b [không có người chờ]
            Service -> BCDAO : 4.4 : updateStatus(bookCopyId, 'available')
            return
            Service -> BDAO : 4.5 : incrementAvailableQuantity(bookId)
            return
        end

    else 4.2b [Reservation.status = 'pending' - trong hàng chờ]
        Service -> ResvDAO : 4.3 : shiftQueuePositions\n(conn, bookId, cancelledQueuePosition)
        note right : UPDATE Reservation\nSET queuePosition-1\nWHERE bookId=? AND queuePosition > cancelledPos
        return
    end

    Service -> AuditDAO : 5 : insertAuditLog(userId,\n"CANCEL_RESERVATION",\n"Reservation", reservationId, ...)
    return
    note over Service : COMMIT Transaction
    Service --> Servlet : return void
    Servlet -> User : 6 : flash "Đã hủy đặt trước thành công"
end
@enduml
