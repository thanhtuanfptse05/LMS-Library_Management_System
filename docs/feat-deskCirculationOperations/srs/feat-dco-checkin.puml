@startuml Flow_4_2_NhanSachTraTaiQuay
autoactivate on

actor Librarian
participant "desk-dashboard.jsp" as JSP
participant "AuthFilter" as Filter
participant "CheckInServlet" as Servlet
participant "DeskCirculationService" as Service
participant "BookCopyDAO" as BCDAO
participant "BorrowRecordDAO" as BRDAO
participant "SystemConfigDAO" as ConfigDAO
participant "FineDAO" as FineDAO
participant "UserDAO" as UDAO
participant "UserLockReasonDAO" as LockDAO
participant "ReservationDAO" as ResvDAO
participant "BookDAO" as BDAO
participant "BookCopyIncidentDAO" as IncidentDAO
participant "AuditLogDAO" as AuditDAO
participant "EmailService" as Email

Librarian -> JSP : 1 : quét barcode, chọn condition, submit
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response)
return
Servlet -> Service : 4 : processCheckIn(librarianId, barcode, condition)
Service -> Service : 4.1 : validate condition ('good'/'damaged'/'lost') — fail fast
return

alt 4.1a [condition không hợp lệ]
    Service --> Servlet : throw IllegalStateException(...)
    Servlet --> JSP : set errorMessage, forward

else 4.1b [condition hợp lệ]
    Service -> BCDAO : 5 : findByBarcode(conn, barcode)

    alt 5a [barcode không tồn tại hoặc status != 'borrowed']
        BCDAO --> Service : return null / wrong status
        Service --> Servlet : throw IllegalStateException(...)
        Servlet --> JSP : forward

    else 5b [barcode hợp lệ, status = 'borrowed']
        BCDAO --> Service : return BookCopy
        Service -> BRDAO : 6 : findActiveBorrowRecord(conn, bookCopyId)

        alt 6a [không tìm thấy BorrowRecord active]
            BRDAO --> Service : return null
            Service --> Servlet : throw IllegalStateException\n("Dữ liệu không nhất quán")
            Servlet --> JSP : forward

        else 6b [BorrowRecord hợp lệ]
            BRDAO --> Service : return BorrowRecord (userId, bookId, endDate)
            note over Service : BEGIN Transaction\nconn.setAutoCommit(false)

            alt 7a [condition = 'good' - processCheckInGood()]
                Service -> Service : 7.1 : tính overdueDays = (NOW - endDate) in days
                return

                opt 7.1a [overdueDays > 0 - trễ hạn]
                    Service -> ConfigDAO : 7.2 : getValue(conn, "FINE_RATE_PER_DAY")
                    return
                    Service -> FineDAO : 7.3 : insertOverdueFine\n(borrowRecordId, userId, fineAmount, reason='overdue')
                    return
                    Service -> LockDAO : 7.4 : insertLockReason(userId, "unpaid")
                    return
                    Service -> UDAO : 7.5 : updateStatus(userId, 'locked')
                    return
                end

                Service -> BRDAO : 7.6 : updateStatus\n(borrowRecordId, 'returned', returnedAt=NOW())
                return
                Service -> BCDAO : 7.7 : updateStatus(bookCopyId, 'available', 'good')
                return
                Service -> ResvDAO : 7.8 : findNextInQueue(conn, bookId)

                alt 7.8a [có người chờ tiếp theo - điều phối FR-39]
                    ResvDAO --> Service : return nextReservation
                    Service -> ResvDAO : 7.9 : promoteToReadyPickup\n(nextReservationId, bookCopyId,\nendDate=NOW()+HOLD_DAYS)
                    return
                    Service -> BCDAO : 7.10 : updateStatus(bookCopyId, 'reserved')
                    return
                    Service -> Email : 7.11 : enqueue(RESERVATION_READY, nextUserId)
                    note right : Bất đồng bộ
                    return

                else 7.8b [không có người chờ]
                    Service -> BDAO : 7.9 : incrementAvailableQuantity(bookId)
                    return
                end

            else 7b [condition = 'damaged'/'lost' - processCheckInDamagedOrLost()]
                Service -> Service : 7.1 : calculateCompensationAmount\n(conn, bookId, condition)
                return
                Service -> FineDAO : 7.2 : insertCompensationFine\n(borrowRecordId, userId, fineAmount, reason=condition)
                return
                Service -> BRDAO : 7.3 : updateStatus\n(borrowRecordId, 'returned', returnedAt=NOW())
                return
                Service -> BCDAO : 7.4 : updateStatus(bookCopyId, 'unavailable', condition)
                return
                Service -> BDAO : 7.5 : decrementTotalQuantity(bookId)
                note right : UPDATE Book SET totalQuantity-1\nSách không còn lưu thông (BR-24)
                return
                Service -> IncidentDAO : 7.6 : insertIncident\n(bookCopyId, type=condition,\nreportedBy=librarianId)
                return
                Service -> LockDAO : 7.7 : insertLockReason(userId, "unpaid")
                return
                Service -> UDAO : 7.8 : updateStatus(userId, 'locked')
                return
                note right : KHÔNG điều phối hàng chờ\n— sách hỏng/mất không lưu thông
            end

            Service -> AuditDAO : 8 : insertAuditLog(librarianId,\n"CHECKIN", "BorrowRecord",\nborrowRecordId, ...)
            return
            note over Service : COMMIT Transaction
            Service -> Email : 9 : enqueue(CHECKIN_CONFIRMATION, userId)
            note right : Bất đồng bộ
            return
            Service --> Servlet : return CheckInResult
            Servlet -> Librarian : 10 : set successMessage "Nhận sách thành công"
        end
    end
end
@enduml
