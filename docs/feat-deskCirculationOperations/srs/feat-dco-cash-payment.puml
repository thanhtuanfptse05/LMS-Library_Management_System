@startuml Flow_4_3_ThanhToanTienMatTaiQuay
autoactivate on

actor Librarian
participant "desk-dashboard.jsp" as JSP
participant "AuthFilter" as Filter
participant "CashPaymentServlet" as Servlet
participant "DeskCirculationService" as Service
participant "PaymentDAO" as PayDAO
participant "FineDAO" as FineDAO
participant "UserDAO" as UDAO
participant "UserLockReasonDAO" as LockDAO
participant "AuditLogDAO" as AuditDAO
participant "EmailService" as Email

Librarian -> JSP : 1 : chọn khoản phạt, xác nhận thu tiền
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response) [fineId, paymentId]
return
Servlet -> Service : 4 : approveCashPayment(librarianId, fineId, paymentId)
note over Service : BEGIN Transaction\nconn.setAutoCommit(false)
Service -> PayDAO : 4.1 : updateCashPaymentSuccess\n(conn, paymentId, librarianId)
note right : UPDATE Payment SET status='completed'\nprocessedBy=librarianId, paidAt=NOW()
return
Service -> FineDAO : 4.2 : updateStatusToPaid(conn, fineId)
return
Service -> UDAO : 4.3 : findUserIdByFineId(conn, fineId)
return
Service -> LockDAO : 4.4 : deleteLockReason(conn, userId, "unpaid")
return
Service -> LockDAO : 4.5 : countLockReasons(conn, userId)
return

opt 4.5a [count == 0 - auto-unlock BR-25]
    Service -> UDAO : 4.6 : unlockAccount(userId)
    note right : UPDATE "User" SET status='active'
    return
end

Service -> AuditDAO : 4.7 : insertAuditLog(librarianId,\n"CASH_PAYMENT", "Payment",\npaymentId, "pending", "completed")
return
note over Service : COMMIT Transaction
Service -> Email : 5 : enqueue(PAYMENT_CONFIRMATION, userId)
note right : Bất đồng bộ
return
Service --> Servlet : return void

alt 5a [count > 0 - còn adminban/securitybreach]
    Servlet --> JSP : set warnMessage\n"Thanh toán thành công nhưng\ntài khoản vẫn bị khóa do lý do khác"
else 5b [count == 0]
    Servlet -> Librarian : set successMessage\n"Thanh toán thành công, tài khoản đã mở khóa"
end
@enduml
