@startuml Flow_7_1_TraCuuSach
autoactivate on

actor User
participant "book-search.jsp" as JSP
participant "AuthFilter" as Filter
participant "BookSearchServlet" as Servlet
participant "BookDAO" as BDAO
participant "BorrowRecordDAO" as BRDAO
participant "ReservationDAO" as ResvDAO

User -> JSP : 1 : nhập keyword, chọn filter\n(category/tag), submit
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doGet(request, response)
return
Servlet -> Servlet : 4 : parse params\n(keyword, categoryId, tagIds[], page, pageSize=12)
return
Servlet -> BDAO : 5 : search\n(keyword, categoryId, tagIds[],\nstatus='active', offset, limit)
note right : SQL ILIKE '%keyword%'\ntrên title/author/isbn/publisher\nPagination: OFFSET (page-1)*12 LIMIT 12
return
Servlet -> BDAO : 5.1 : findAllCategories()
return
Servlet -> BDAO : 5.2 : findAllTags()
return

opt 5.3 [User đã đăng nhập]
    Servlet -> BRDAO : 5.4 : findActiveBorrowedBookIdsByUser(userId)
    return
    Servlet -> ResvDAO : 5.5 : findActiveReservedBookIdsByUser(userId)
    return
end

Servlet --> JSP : 6 : forward book-search.jsp\nvới {books[], totalCount, pagination,\ncategories[], tags[],\nborrowedIds, reservedIds}

alt 6a [không có kết quả]
    JSP --> User : hiển thị "Không có kết quả\nphù hợp với tìm kiếm của bạn"

else 6b [có kết quả]
    JSP --> User : hiển thị danh sách sách với nhãn\n(Đang mượn / Đã đặt / Có sẵn)
end
@enduml
