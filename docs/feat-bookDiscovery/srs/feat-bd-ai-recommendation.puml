@startuml Flow_7_2_GoiYSachAI
autoactivate on

actor User
participant "book-detail.jsp" as JSP
participant "AuthFilter" as Filter
participant "RecommendationServlet" as Servlet
participant "AiRecommendationService" as Service
participant "BorrowRecordDAO" as BRDAO
participant "BookDAO" as BDAO
participant "GeminiAPI" as Gemini

User -> JSP : 1 : mở trang chi tiết sách
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doGet(request, response)
return
Servlet -> Servlet : 4 : kiểm tra session\n"cachedRecommendations" + TTL 30 phút
return

alt 4a [Cache HIT - chưa hết 30 phút]
    Servlet --> JSP : forward book-detail.jsp\nvới recommendations từ cache
    JSP --> User : hiển thị "Sách gợi ý cho bạn"

else 4b [Cache MISS]
    Servlet -> Service : 5 : getRecommendationsForUser\n(userId, currentBookId, role)
    Service -> BRDAO : 5.1 : findBorrowedBookIdsByUser(userId)
    return

    alt 5.1a [chưa có lịch sử mượn - BR-66 fallback]
        BRDAO --> Service : return empty list
        Service -> BDAO : 5.2 : findTrendingBooks(limit=10)
        return
        Service --> Servlet : return {source: "trending", books: trendingList}

    else 5.1b [có lịch sử mượn]
        Service -> BDAO : 5.2 : findCategoriesAndTagsByBookId(currentBookId)
        return
        Service -> BDAO : 5.3 : findAvailableIsbnList(status='active')
        return
        Service -> Service : 5.4 : buildRAGPrompt\n(borrowHistory, categories, tags, availableIsbns)
        return
        Service -> Gemini : 5.5 : POST /generateContent (RAG prompt)

        alt 5.5a [GeminiAPI lỗi / timeout - BR-66 fallback]
            Gemini --> Service : Error / Timeout
            Service -> BDAO : 5.6 : findTrendingBooks(limit=10)
            return
            Service --> Servlet : return {source: "trending_fallback",\nbooks: trendingList}

        else 5.5b [GeminiAPI trả kết quả]
            Gemini --> Service : JSON {recommendedIsbns: [...]}
            Service -> Service : 5.6 : parseRecommendedIsbns(jsonResponse)
            return
            Service -> BDAO : 5.7 : findByIsbnList(isbns[])
            return
            Service --> Servlet : return {source: "ai", books: recommendedBooks}
        end
    end

    Servlet -> Servlet : 6 : session.setAttribute\n("cachedRecommendations",\n{books, timestamp=NOW()})
    return
    Servlet --> JSP : 7 : forward book-detail.jsp\nvới recommendations[]
    JSP --> User : hiển thị "Sách gợi ý cho bạn"
end
@enduml
