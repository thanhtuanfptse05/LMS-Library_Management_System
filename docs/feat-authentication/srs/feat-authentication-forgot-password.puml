@startuml Flow_1_2_QuenMatKhau
autoactivate on

actor Guest
participant "forgot-password.jsp" as JSP
participant "AuthFilter" as Filter
participant "ForgotPasswordServlet" as Servlet
participant "AuthService" as Service
participant "UserDAO" as DAO
participant "EmailService" as Email

Guest -> JSP : 1 : nhập email, submit
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response)
return
Servlet -> Service : 4 : resetPassword(email)
Service -> DAO : 4.1 : findByEmail(email)

alt 4.1a [email KHÔNG tồn tại - BR-04 chống lộ email]
    DAO --> Service : return null
    Service --> Servlet : return null
    note right : Không UPDATE DB, không gửi email\nChống lộ thông tin email tồn tại
    Servlet -> Servlet : set successMessage (thông báo chung)
    return
    Servlet --> JSP : forward forgot-password.jsp

else 4.1b [email tồn tại]
    DAO --> Service : return User
    Service -> Service : 4.2 : generateRandomPassword()
    return
    Service -> Service : 4.3 : BCrypt.hashpw(rawPassword, BCrypt.gensalt(10))
    return
    Service -> DAO : 4.4 : updatePasswordHash(userId, hashedPassword)
    return
    Service --> Servlet : return rawPassword
    Servlet -> Email : 5 : enqueue(RESET_PASSWORD_TEMPLATE,\n{email, rawPassword})
    note right : Bất đồng bộ qua EmailWorker
    return
    Servlet -> Servlet : set successMessage (cùng thông báo chung)
    return
    Servlet --> JSP : forward forgot-password.jsp
end

JSP --> Guest : 6 : hiển thị "Nếu email tồn tại,\nchúng tôi đã gửi mật khẩu tạm"
@enduml
