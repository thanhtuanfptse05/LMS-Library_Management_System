@startuml Flow_1_1_DangNhapEmailPassword
autoactivate on

actor User
participant "login.jsp" as JSP
participant "AuthFilter" as Filter
participant "LoginServlet" as Servlet
participant "AuthService" as Service
participant "UserDAO" as DAO
participant "UserLockReasonDAO" as LockDAO
participant "MemberProfileDAO" as ProfDAO

User -> JSP : 1 : nhập email & mật khẩu, submit
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response)
return
Servlet -> DAO : 4 : findByEmail(email)

alt 4a [email không tồn tại trong DB]
    DAO --> Servlet : return null
    Servlet -> Service : 4.1 : runDummyVerify()
    note right : Chống Timing Attack — BCrypt dummy check
    return
    Servlet -> Servlet : set errorMessage = "Tài khoản hoặc mật khẩu không chính xác"
    return
    Servlet --> JSP : forward login.jsp

else 4b [email tồn tại]
    DAO --> Servlet : return User
    Servlet -> Service : 5 : verifyPassword(password, user.getPasswordHash())

    alt 5a [mật khẩu SAI]
        Service --> Servlet : return false
        Servlet -> Service : 5.1 : handleFailedLogin(user)
        Service -> DAO : 5.1.1 : updateFailedAttempts(userId, newAttempts)
        return
        opt 5.1a [newAttempts >= 5]
            Service -> DAO : 5.1.2 : lockAccount(userId)
            note right : UPDATE "User" status='locked'\nlockedUntil=NOW()+30min\nINSERT UserLockReason reason='securitybreach'
            return
        end
        Service --> Servlet : return failedAttempts
        Servlet -> Servlet : set errorMessage (kèm số lần còn lại hoặc thông báo khóa)
        return
        Servlet --> JSP : forward login.jsp

    else 5b [mật khẩu ĐÚNG]
        Service --> Servlet : return true
        Servlet -> Service : 6 : isLockedOnlyForUnpaid(userId)
        Service -> LockDAO : 6.1 : hasReason(userId, "unpaid")
        return
        Service -> LockDAO : 6.2 : hasReason(userId, "securitybreach")
        return
        Service --> Servlet : return boolean

        alt 6a [tài khoản bị khóa vĩnh viễn - adminban/securitybreach]
            opt 6a.1 [lockedUntil != null AND lockedUntil <= NOW()]
                Servlet -> DAO : 6.1 : unlockAccount(userId)
                note right : UPDATE "User" status='active'\nfailedLoginAttempts=0
                return
            end
            Servlet --> JSP : sendRedirect("/login?error=locked")

        else 6b [chỉ khóa do unpaid HOẶC tài khoản active]
            Servlet -> DAO : 7 : resetFailedAttempts(userId)
            return
            Servlet -> ProfDAO : 8 : findByUserId(userId)
            return
            Servlet -> Servlet : 9 : session.setAttribute\n(userId, role, email, fullName)
            return
            opt 9a [isLockedOnlyForUnpaid = true]
                Servlet -> Servlet : session.setAttribute("unpaidWarning", true)
                return
            end
            Servlet -> User : 10 : sendRedirect(getRedirectByRole(contextPath, role))
        end
        deactivate Service
    end
end
@enduml
