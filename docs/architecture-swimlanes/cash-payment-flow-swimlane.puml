@startuml
!theme plain
title Sơ đồ Phân làn (Activity Swimlane): Luồng Duyệt Thanh toán Tiền mặt & Tự động Mở khóa (Cash Payment & Auto-Unlock Flow)

|Thủ thư (Librarian)|
start
:Nhập Mã phiếu thanh toán (paymentId) và Mã độc giả (memberCode) tại bàn làm việc Quầy;
:Nhấn nút "Duyệt Thanh Toán" (Submit Form POST /librarian/cash-payment);

|Controller (CashPaymentServlet)|
:CashPaymentServlet.doPost() tiếp nhận Request;
if (Phiên làm việc hợp lệ & Role == 'LIBRARIAN'?) then (Không)
  :Chuyển hướng (302) về /login;
  stop
else (Hợp lệ)
  :Validate tham số paymentIdRaw và memberCode;
  if (paymentId hoặc memberCode bị trống / không đúng định dạng số?) then (Lỗi đầu vào)
    :Gán session.errorMessage = "Vui lòng nhập đầy đủ / nhập số hợp lệ";
    :Chuyển hướng (302) về /librarian/desk-dashboard?memberCode=...;
    stop
  else (Đầu vào hợp lệ)
    |Business Service (DeskCirculationService)|
    :Mở Connection & Bắt đầu Atomic DB Transaction (conn.setAutoCommit(false));
    
    :UserLookupDAO.findUserIdByMemberCode(conn, memberCode);
    |Cơ sở dữ liệu (PostgreSQL)|
    :SELECT userId FROM Student/Lecturer/MemberProfile WHERE code = ?;
    
    |Business Service (DeskCirculationService)|
    if (Mã độc giả tồn tại?) then (Không tồn tại)
      :Rollback Transaction;
      :Gán session.errorMessage = "Mã số độc giả không tồn tại";
      |Controller (CashPaymentServlet)|
      :Chuyển hướng (302) về /librarian/desk-dashboard?memberCode=...;
      stop
    else (Xác định được userId)
      |Business Service (DeskCirculationService)|
      :Gọi DeskCirculationService.approveCashPayment(librarianId, paymentId, userId);
      
      :ReservationDAO.cancelExpiredReservations(conn);
      |Cơ sở dữ liệu (PostgreSQL)|
      :UPDATE Reservation SET status = 'cancelled' WHERE status = 'readypickup' AND endDate < NOW();
      
      |Business Service (DeskCirculationService)|
      :PaymentDAO.findFineIdByPaymentId(conn, paymentId) [Bước 1];
      |Cơ sở dữ liệu (PostgreSQL)|
      :SELECT fineId FROM Payment WHERE paymentId = ?;
      
      |Business Service (DeskCirculationService)|
      if (Phiếu thanh toán paymentId tồn tại?) then (Không tồn tại fineId = -1)
        :Rollback Transaction;
        :Ném IllegalStateException("Phiếu thanh toán #... không tồn tại");
      else (Tồn tại fineId)
        note right
          Thực thi Atomic Transaction 5 bước BR-25:
          1. Payment -> completed
          2. Fine -> paid
          3. Delete UserLockReason('unpaid')
          4. Count remaining lock reasons
          5. If count == 0 -> User.status -> active
        end note

        :PaymentDAO.updateStatusToCompleted(conn, paymentId, librarianId) [Bước 2];
        |Cơ sở dữ liệu (PostgreSQL)|
        :UPDATE Payment SET status = 'completed', processedBy = ?, paidAt = NOW() WHERE paymentId = ?;
        
        |Business Service (DeskCirculationService)|
        :FineDAO.updateStatusToPaid(conn, fineId) [Bước 3];
        |Cơ sở dữ liệu (PostgreSQL)|
        :UPDATE Fine SET status = 'paid' WHERE fineId = ?;
        
        |Business Service (DeskCirculationService)|
        :UserLockReasonDAO.deleteLockReason(conn, userId, "unpaid") [Bước 4];
        |Cơ sở dữ liệu (PostgreSQL)|
        :DELETE FROM UserLockReason WHERE userId = ? AND reason = 'unpaid';
        
        |Business Service (DeskCirculationService)|
        :UserLockReasonDAO.countLockReasonsByUserId(conn, userId) [Bước 5 - Gate BR-25];
        |Cơ sở dữ liệu (PostgreSQL)|
        :SELECT COUNT(*) FROM UserLockReason WHERE userId = ?;
        
        |Business Service (DeskCirculationService)|
        if (Số lý do khóa còn lại (remainingReasons) == 0?) then (Không còn lý do nào khác)
          :UserDAO.updateStatusToActive(conn, userId);
          |Cơ sở dữ liệu (PostgreSQL)|
          :UPDATE "User" SET status = 'active' WHERE userId = ?;
          |Business Service (DeskCirculationService)|
          :Ghi nhận tài khoản đã được tự động mở khóa (BR-25);
        else (Còn lý do khác: adminban / securitybreach)
          :Giữ nguyên status='locked' của tài khoản (An toàn BR-25);
        endif
        
        :UserDAO.insertAuditLog(librarianId, "CASH_PAYMENT", "Payment", paymentId, ...);
        |Cơ sở dữ liệu (PostgreSQL)|
        :INSERT INTO AuditLogs (userId, actionType, entityName, ...) VALUES (?, 'CASH_PAYMENT', ...);
        
        |Business Service (DeskCirculationService)|
        :Commit DB Transaction (conn.commit());
        :EmailService.sendPaymentConfirmationEmail(paymentId, userId, "Cash") (Async);
      endif
    endif

    |Controller (CashPaymentServlet)|
    if (Service thực thi thành công?) then (Thành công)
      :Gán session.successMessage = "Duyệt thanh toán thành công! Phiếu #... Trạng thái tài khoản đã được cập nhật.";
    else (Catch Exception)
      :Gán session.errorMessage = e.getMessage();
    endif
    
    :Chuyển hướng (302 PRG) về /librarian/desk-dashboard?memberCode=...;
    stop
  endif
endif
@enduml
