@startuml
!theme plain
title Sơ đồ Phân làn (Activity Swimlane): Luồng Xác thực & Phân quyền Truy cập (Auth & Security Flow)

|Người dùng (Browser)|
start
:Nhập Email và Mật khẩu trên Form Đăng nhập;
:Gửi HTTP POST request tới /login;

|Controller (LoginServlet / AuthFilter)|
:AuthFilter tiếp nhận Request;
if (URI thuộc nhóm công khai /login?) then (Đúng)
  :AuthFilter cho qua tới LoginServlet.doPost();
else (Trang bảo vệ)
  if (HttpSession tồn tại & có userId + role?) then (Không)
    :Chuyển hướng (302) về /login;
    stop
  else (Có Session)
    |Business Logic (AuthService / UserDAO)|
    :UserDAO.findByUserId(sessionUserId);
    |Cơ sở dữ liệu (PostgreSQL)|
    :SELECT * FROM "User" WHERE userId = ?;
    |Business Logic (AuthService / UserDAO)|
    if (User tồn tại & status == 'active' HOẶC status == 'locked' do chỉ 'unpaid'?) then (Cho phép)
      :AuthFilter kiểm tra Role vs URL pattern;
      if (Role khớp với quyền truy cập URL?) then (Khớp)
        :Forward tới Servlet đích (200 OK);
        stop
      else (Không khớp)
        :Trả về lỗi 403 Forbidden;
        stop
      endif
    else (Bị khóa vĩnh viễn/chưa login)
      :Hủy HttpSession (session.invalidate());
      :Chuyển hướng về /login?error=locked;
      stop
    endif
  endif
endif

|Controller (LoginServlet / AuthFilter)|
:LoginServlet.doPost() validate tham số email, password;
if (Email hoặc Password trống/null?) then (Trống)
  :Gán errorMessage = "Email hoặc mật khẩu không được bỏ trống.";
  :Forward tới /auth/login.jsp;
  stop
else (Đủ tham số)
  |Business Logic (AuthService / UserDAO)|
  :UserDAO.findByEmail(email.trim());
  
  |Cơ sở dữ liệu (PostgreSQL)|
  :SELECT userId, email, passwordHash, status, role, failedLoginAttempts, lockedUntil FROM "User" WHERE email = ?;
  
  |Business Logic (AuthService / UserDAO)|
  if (User tồn tại trong CSDL?) then (Không tồn tại)
    :Chạy authService.runDummyVerify() (chống Timing Attack);
    |Controller (LoginServlet / AuthFilter)|
    :Gán errorMessage = "Tài khoản hoặc mật khẩu không chính xác.";
    :Forward tới /auth/login.jsp;
    stop
  else (User tồn tại)
    |Business Logic (AuthService / UserDAO)|
    if (User.status == 'locked'?) then (Đang bị khóa)
      if (lockedUntil đã hết hạn: lockedUntil <= NOW()?) then (Đã hết hạn khóa 30p)
        :UserDAO.unlockAccount(userId);
        |Cơ sở dữ liệu (PostgreSQL)|
        :UPDATE "User" SET status = 'active', failedLoginAttempts = 0, lockedUntil = NULL WHERE userId = ?;
        |Business Logic (AuthService / UserDAO)|
        :Cập nhật user memory status = 'active';
      else (Vẫn đang bị khóa)
        :AuthService.isLockedOnlyForUnpaid(userId);
        |Cơ sở dữ liệu (PostgreSQL)|
        :SELECT 1 FROM UserLockReason WHERE userId = ? AND reason = ?;
        |Business Logic (AuthService / UserDAO)|
        if (Chỉ bị khóa do lý do 'unpaid'?) then (Đúng - Cho qua có cảnh báo)
          :Đặt flag request.setAttribute("unpaidWarning", true);
        else (Khóa do sai mật khẩu 5 lần hoặc Admin ban)
          |Controller (LoginServlet / AuthFilter)|
          :Gán errorMessage thông báo khóa tài khoản;
          :Forward tới /auth/login.jsp;
          stop
        endif
      endif
    endif

    |Business Logic (AuthService / UserDAO)|
    :AuthService.verifyPassword(password, user.passwordHash) qua BCrypt.checkpw;
    if (Mật khẩu nhập vào chính xác?) then (Sai mật khẩu)
      :AuthService.handleFailedLogin(user);
      :Tăng newAttempts = failedLoginAttempts + 1;
      if (newAttempts >= 5?) then (Đạt 5 lần sai)
        :UserDAO.lockAccount(userId);
        |Cơ sở dữ liệu (PostgreSQL)|
        :UPDATE "User" SET status = 'locked', lockedUntil = NOW() + 30 minutes WHERE userId = ?;
        |Controller (LoginServlet / AuthFilter)|
        :Gán errorMessage = "Tài khoản bị khóa tạm thời 30 phút...";
      else (Dưới 5 lần)
        :UserDAO.updateFailedAttempts(userId, newAttempts);
        |Cơ sở dữ liệu (PostgreSQL)|
        :UPDATE "User" SET failedLoginAttempts = ? WHERE userId = ?;
        |Controller (LoginServlet / AuthFilter)|
        :Gán errorMessage = "Tài khoản hoặc mật khẩu không chính xác...";
      endif
      :Forward tới /auth/login.jsp;
      stop
    else (Mật khẩu ĐÚNG)
      |Business Logic (AuthService / UserDAO)|
      :UserDAO.resetFailedAttempts(userId);
      |Cơ sở dữ liệu (PostgreSQL)|
      :UPDATE "User" SET failedLoginAttempts = 0 WHERE userId = ?;
      
      |Controller (LoginServlet / AuthFilter)|
      :Khởi tạo HttpSession mới (session.setAttribute("userId", ...));
      :Lưu userId, role, email, fullName vào Session;
      :Xác định URL chuyển hướng theo Role hoặc redirectParam hợp lệ;
      :Chuyển hướng (sendRedirect) về Dashboard tương ứng (302);
      stop
    endif
  endif
endif
@enduml
