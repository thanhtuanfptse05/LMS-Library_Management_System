@startuml Flow_6_1_XemPhatVaTaoMaQR
autoactivate on

actor User
participant "member-fines.jsp" as JSP
participant "AuthFilter" as Filter
participant "MemberFinesServlet" as Servlet
participant "FineDAO" as FineDAO
participant "PaymentDAO" as PayDAO
participant "SystemConfigDAO" as ConfigDAO

User -> JSP : 1 : mở trang "Lịch sử phạt & Thanh toán"
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doGet(request, response)
return
Servlet -> FineDAO : 4 : findByUserId(userId)
return
Servlet -> PayDAO : 5 : insertPaymentIfAbsent\n(fineId, amount,\nmethod='BankTransfer', status='pending')
note right : Chỉ INSERT nếu chưa có\npending Payment cho fineId này
return
Servlet -> ConfigDAO : 6 : getValue("SEPAY_ACCOUNT_NUMBER")
return
Servlet -> ConfigDAO : 6.1 : getValue("SEPAY_BANK_CODE")
return
Servlet -> ConfigDAO : 6.2 : getValue("SEPAY_ACCOUNT_NAME")
return
Servlet -> Servlet : 7 : tính totalUnpaid\n= SUM(amount WHERE status='unpaid')
return
Servlet --> JSP : 8 : forward member-fines.jsp\nvới {fines[], totalUnpaid, sePayConfig}
note right of JSP : Sinh URL VietQR cho mỗi khoản:\nnội dung = "LMSPF{paymentId}"
JSP --> User : 9 : hiển thị danh sách phạt + QR code
@enduml
