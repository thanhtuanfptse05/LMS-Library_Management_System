@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam backgroundColor #FEFEFE
skinparam shadowing false

' ── External Actors ──
actor "Sinh viên" as Student
actor "Google OAuth" as Google
actor "SePay\n(Payment Gateway)" as SePay
actor "Gemini AI\n(Gợi ý sách)" as AI

rectangle "Hệ thống Thư viện Đại học (LMS)" {

  package "Xác thực" {
    usecase "Đăng nhập" as UC01
    usecase "Đăng nhập Google" as UC02
    usecase "Quên mật khẩu\n& Đặt lại mật khẩu" as UC03
    usecase "Đăng xuất" as UC04
  }

  package "Tra cứu sách" {
    usecase "Tìm kiếm sách\n(theo từ khóa, danh mục, tag)" as UC05
    usecase "Xem chi tiết sách" as UC06
    usecase "Nhận gợi ý sách\ntừ AI" as UC07
  }

  package "Giao dịch mượn trả" {
    usecase "Đặt trước sách" as UC08
    usecase "Hủy đặt trước sách" as UC09
    usecase "Gia hạn mượn sách" as UC10
    usecase "Xem sách đang mượn\n& đặt trước" as UC11
    usecase "Xem lịch sử\nmượn trả sách" as UC12
  }

  package "Phạt & Thanh toán" {
    usecase "Xem danh sách\ntiền phạt" as UC13
    usecase "Thanh toán phạt\nqua QR (VietQR)" as UC14
  }

  package "Hồ sơ cá nhân" {
    usecase "Xem & cập nhật\nthông tin cá nhân" as UC15
    usecase "Đổi mật khẩu" as UC16
  }

  package "Thông báo" {
    usecase "Xem bảng tin\nhệ thống" as UC17
    usecase "Đánh dấu\nthông báo đã đọc" as UC18
  }

  package "Tổng quan" {
    usecase "Xem Dashboard\nsinh viên" as UC19
  }
}

' ── Student associations ──
Student -- UC01
Student -- UC02
Student -- UC03
Student -- UC04
Student -- UC05
Student -- UC06
Student -- UC07
Student -- UC08
Student -- UC09
Student -- UC10
Student -- UC11
Student -- UC12
Student -- UC13
Student -- UC14
Student -- UC15
Student -- UC16
Student -- UC17
Student -- UC18
Student -- UC19

' ── External system associations ──
UC02 -- Google
UC14 -- SePay
UC07 -- AI

' ── Relationships (evidence-based) ──
' UC02 (Đăng nhập Google) include UC01 logic xác thực session — GoogleLoginServlet
' gọi chung AuthService.login() và tạo session giống LoginServlet
UC02 ..> UC01 : <<include>>

' UC14 (Thanh toán QR) mở rộng UC13 (Xem phạt) — chỉ xuất hiện khi có khoản unpaid
' MemberFinesServlet tự tạo Payment pending cho Fine unpaid, UI hiển thị nút QR
UC14 ..> UC13 : <<extend>>

@enduml
