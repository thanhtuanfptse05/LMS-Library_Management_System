@startuml Flow_3_2_4_LockUnlockAccount
autoactivate on

actor Admin
participant "user-detail.jsp" as JSP
participant "AuthFilter" as Filter
participant "UpdateUserServlet" as Servlet
participant "UserDAO" as DAO
participant "UserLockReasonDAO" as LockDAO
participant "AuditLogDAO" as AuditDAO

Admin -> JSP : 1 : click "Lock" or "Unlock"\n(targetUserId, action)
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response)
return
Servlet -> Servlet : 4 : targetUserId == session.getAttribute("userId")?
return

alt 4a [self-lock - BR-55]
    Servlet --> JSP : set errorMessage\n"Cannot perform operation on currently logged-in account"

else 4b [action = "lock" - Lock Account]
    Servlet -> LockDAO : 5 : insertLockReason(targetUserId, "adminban")
    return
    Servlet -> DAO : 6 : updateStatus(targetUserId, "locked")
    note right : UPDATE "User" SET status='locked'
    return
    Servlet -> AuditDAO : 7 : insertAuditLog(adminId,\n"LOCK_ACCOUNT", "User",\ntargetUserId, "active", "locked")
    return
    Servlet -> Admin : 8 : sendRedirect\n("/admin/users/{id}?success=locked")

else 4c [action = "unlock" - Unlock Account]
    Servlet -> LockDAO : 5 : deleteLockReason(targetUserId, "adminban")
    return
    Servlet -> LockDAO : 6 : countLockReasons(targetUserId)
    return

    opt 6a [count == 0 - no remaining lock reasons]
        Servlet -> DAO : 6.1 : unlockAccount(targetUserId)
        note right : UPDATE "User" SET status='active', lockedUntil=NULL
        return
    end

    Servlet -> AuditDAO : 7 : insertAuditLog(adminId,\n"UNLOCK_ACCOUNT", "User",\ntargetUserId, "locked", result)
    return

    alt 7a [count > 0 - remaining unpaid/securitybreach reasons]
        Servlet --> JSP : flash warning\n"Account remains locked due to other reasons"
    else 7b [count == 0]
        Servlet -> Admin : sendRedirect\n("/admin/users/{id}?success=unlocked")
    end
end
@enduml
