@startuml Flow_3_6_3_SePayWebhook
autoactivate on

participant "SePayGateway" as SePay
participant "AuthFilter" as Filter
participant "SePayWebhookServlet" as Servlet
participant "PaymentDAO" as PayDAO
participant "FineDAO" as FineDAO
participant "UserDAO" as UDAO
participant "UserLockReasonDAO" as LockDAO
participant "AuditLogDAO" as AuditDAO
participant "EmailService" as Email

SePay -> Filter : 1 : POST /api/sepay-webhook\n(JSON: content, code, transferAmount, referenceCode)
note right : AuthFilter bypass route /api/sepay-webhook\nCustom authentication via API Key
return
Filter -> Servlet : 2 : doPost(request, response)
return
Servlet -> Servlet : 3 : check Authorization header\nvs SystemConfigDAO.getValue("SEPAY_API_KEY")
return

alt 3a [API key mismatch]
    Servlet --> SePay : HTTP 401 Unauthorized

else 3b [API key valid]
    Servlet -> Servlet : 4 : parse JSON → regex\nfind "LMSPF(\d+)" in content/code
    return

    alt 4a [paymentId not found - missing LMSPF pattern]
        Servlet --> SePay : HTTP 200\n{success: false,\nmessage: "Payment code not found"}

    else 4b [paymentId found]
        Servlet -> PayDAO : 5 : findByPaymentId(paymentId)
        return

        alt 5a [Payment already completed - duplicate webhook - idempotent]
            PayDAO --> Servlet : return Payment (status=completed)
            Servlet --> SePay : HTTP 200\n{success: true,\nmessage: "Already processed"}

        else 5b [Payment still pending]
            note over Servlet : BEGIN Transaction
            Servlet -> PayDAO : 6 : updatePaymentOnlineSuccess\n(conn, paymentId, transactionRef, amount)
            note right : UPDATE Payment\nSET status='completed'\ntransactionReference=ref, paidAt=NOW()
            return
            Servlet -> FineDAO : 6.1 : updateStatusToPaid(conn, fineId)
            return
            Servlet -> UDAO : 6.2 : findUserIdByFineId(conn, fineId)
            return
            Servlet -> LockDAO : 6.3 : deleteLockReason(conn, userId, "unpaid")
            return
            Servlet -> LockDAO : 6.4 : countLockReasons(conn, userId)
            return

            opt 6.4a [count == 0 - auto-unlock BR-25]
                Servlet -> UDAO : 6.5 : unlockAccount(userId)
                return
            end

            Servlet -> AuditDAO : 6.6 : insertAuditLog(null,\n"SEPAY_WEBHOOK_PAYMENT",\n"Payment", paymentId, ...)
            return
            note over Servlet : COMMIT Transaction
            Servlet -> Email : 7 : enqueue(PAYMENT_CONFIRMATION, userId)
            note right : Asynchronous
            return
            Servlet --> SePay : 8 : HTTP 200\n{success: true,\nmessage: "Payment successful"}
        end
    end
end
@enduml
