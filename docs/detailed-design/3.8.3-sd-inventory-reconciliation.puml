@startuml Flow_3_8_3_InventoryReconciliation
autoactivate on

actor Librarian
participant "inventory-session.jsp" as JSP
participant "AuthFilter" as Filter
participant "InventoryReconciliationServlet" as Servlet
participant "InventoryReconciliationService" as Service
participant "InventoryDAO" as InvDAO
participant "BookCopyDAO" as BCDAO
participant "BookCopyIncidentDAO" as IncidentDAO
participant "BookDAO" as BDAO
participant "AuditLogDAO" as AuditDAO

== PHASE 1 — Create Inventory Session ==

Librarian -> JSP : 1 : enter location & note, submit\n(action=create)
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response) [action=create]
return
Servlet -> Service : 4 : create(location, note, librarianId)
Service -> Service : 4.1 : validateLocation(location)
return

alt 4.1a [location empty or > 255 chars]
    Service --> Servlet : throw ValidationException(...)
    Servlet --> JSP : set errorMessage, forward

else 4.1b [valid location]
    note over Service : BEGIN Transaction
    Service -> InvDAO : 4.2 : insertSession(conn, location,\nnote, librarianId)
    note right : INSERT InventorySession\nstatus='draft', startedBy=librarianId
    return
    Service -> InvDAO : 4.3 : createExpectedItems(conn, sessionId, location)
    note right : INSERT InventoryItem for each BookCopy\nwhere location=? AND status IN ('available','reserved','borrowed')\nresult='pending'
    return
    Service -> AuditDAO : 4.4 : insert(conn, librarianId,\n"CREATE_INVENTORY_SESSION",\n"InventorySession", sessionId, ...)
    return
    note over Service : COMMIT Transaction
    Service --> Servlet : return sessionId
    Servlet -> Librarian : 5 : sendRedirect\n("/librarian/inventory/{id}?success=created")
end

== PHASE 2 — Start Counting ==

Librarian -> JSP : 6 : click "Start Counting"\n(action=start)
return
JSP -> Filter : 7 : doFilter(request, response, chain)
return
Filter -> Servlet : 8 : doPost(request, response) [action=start]
return
Servlet -> Service : 9 : start(sessionId, librarianId)
note over Service : BEGIN Transaction
Service -> InvDAO : 9.1 : findSession(conn, id, forUpdate=true)
return
Service -> Service : 9.2 : requireSession(conn, id, "draft")
note right : Check status must = 'draft'
return
Service -> InvDAO : 9.3 : updateSessionStatus\n(conn, id, "draft", "counting", librarianId)
return
Service -> AuditDAO : 9.4 : insert(conn, librarianId,\n"START_INVENTORY_SESSION", ...)
return
note over Service : COMMIT Transaction
Service --> Servlet : return void
Servlet -> Librarian : 10 : sendRedirect("?success=started")

== PHASE 3 — Scan Barcode per Book Copy ==

loop Each book copy in location
    Librarian -> JSP : 11 : scan barcode (action=scan)
    return
    JSP -> Filter : 12 : doFilter(request, response, chain)
    return
    Filter -> Servlet : 13 : doPost(request, response) [action=scan]
    return
    Servlet -> Service : 14 : scan(sessionId, barcode, librarianId)
    note over Service : BEGIN Transaction
    Service -> Service : 14.1 : requireSession(conn, id, "counting")
    return
    Service -> BCDAO : 14.2 : findByBarcodeForUpdate(conn, barcode)

    alt 14.2a [barcode does not exist]
        BCDAO --> Service : return null
        Service --> Servlet : throw ValidationException\n("Barcode does not exist in system")
        Servlet --> JSP : set errorMessage, forward

    else 14.2b [valid barcode]
        BCDAO --> Service : return BookCopy
        Service -> Service : 14.3 : compare session.location vs copy.location
        return

        alt 14.3a [matching location - result='matched']
            Service -> InvDAO : 14.4 : recordScan(conn, sessionId,\nbookCopyId, location, "matched", librarianId)
            return

        else 14.3b [misplaced location - result='misplaced']
            Service -> InvDAO : 14.4 : recordScan(conn, sessionId,\nbookCopyId, scannedLocation,\n"misplaced", librarianId, expectedLocation)
            return
        end

        Service -> AuditDAO : 14.5 : insert(conn, librarianId,\n"SCAN_INVENTORY_ITEM", "BookCopy",\nbookCopyId, null, scanResult)
        return
        note over Service : COMMIT Transaction
        Service --> Servlet : return void
        Servlet -> Librarian : 15 : set successMessage "Recorded"
    end
end

== PHASE 4 — Finish Counting & Review ==

Librarian -> JSP : 16 : click "Finish Counting"\n(action=finishCounting)
return
JSP -> Filter : 17 : doFilter(request, response, chain)
return
Filter -> Servlet : 18 : doPost(request, response) [action=finishCounting]
return
Servlet -> Service : 19 : finishCounting(sessionId, librarianId)
note over Service : BEGIN Transaction
Service -> Service : 19.1 : requireSession(conn, id, "counting")
return
Service -> InvDAO : 19.2 : markMissing(conn, sessionId)
note right : UPDATE InventoryItem SET result='missing'\nWHERE sessionId=? AND result='pending'\n(unscanned books = missing)
return
Service -> InvDAO : 19.3 : updateSessionStatus\n(conn, id, "counting", "reviewing", librarianId)
return
Service -> AuditDAO : 19.4 : insert(conn, librarianId,\n"REVIEW_INVENTORY_SESSION", ...,\n{missingCount})
return
note over Service : COMMIT Transaction
Service --> Servlet : return void
Servlet -> Librarian : 20 : display discrepancy list\n(misplaced + missing) for resolution

== PHASE 5 — Resolve Discrepancies ==

alt 21a [Resolve misplaced copy - resolveMisplaced]
    Librarian -> JSP : 21 : click "Update Location"\n(action=resolveMisplaced, itemId)
    return
    JSP -> Servlet : 22 : doPost [action=resolveMisplaced]
    return
    Servlet -> Service : 23 : resolveMisplaced(itemId, librarianId)
    note over Service : BEGIN Transaction
    Service -> InvDAO : 23.1 : findItem(conn, itemId, forUpdate=true)
    return
    Service -> BCDAO : 23.2 : findByIdForUpdate(conn, bookCopyId)
    return
    Service -> BCDAO : 23.3 : updateLocation(conn, bookCopyId,\nscannedLocation)
    note right : UPDATE BookCopy SET location=scannedLocation
    return
    Service -> InvDAO : 23.4 : resolveItem(conn, itemId,\n"Location updated per inventory result",\nlibrarianId)
    return
    Service -> AuditDAO : 23.5 : insert(conn, librarianId,\n"RESOLVE_MISPLACED_COPY", "BookCopy",\nbookCopyId, oldLocation, newLocation)
    return
    note over Service : COMMIT Transaction

else 21b [Resolve missing copy - resolveMissing]
    Librarian -> JSP : 21 : click "Report Lost"\n(action=resolveMissing, itemId)
    return
    JSP -> Servlet : 22 : doPost [action=resolveMissing]
    return
    Servlet -> Service : 23 : resolveMissing(itemId, librarianId)
    note over Service : BEGIN Transaction
    Service -> InvDAO : 23.1 : findItem(conn, itemId, forUpdate=true)
    return
    Service -> BCDAO : 23.2 : findByIdForUpdate(conn, bookCopyId)

    alt 23.2a [copy ineligible - borrowed/damaged]
        Service --> Servlet : throw ValidationException\n("Copy is no longer eligible")
        Servlet --> JSP : set errorMessage

    else 23.2b [copy eligible - available + good]
        Service -> IncidentDAO : 23.3 : findOpenByBookCopyId(conn, bookCopyId)

        opt 23.3a [pending incident already exists]
            Service --> Servlet : throw ValidationException\n("Copy already has a pending incident")
        end

        Service -> IncidentDAO : 23.4 : insert(conn, incident)
        note right : INSERT BookCopyIncident\ntype='lost', description='Missing in\ninventory session #{sessionId}'
        return
        Service -> BCDAO : 23.5 : markUnavailable(conn, bookCopyId)
        note right : UPDATE BookCopy\nSET status='unavailable', condition='lost'
        return
        Service -> BDAO : 23.6 : updateQuantities\n(conn, bookId, totalDelta=0, availableDelta=-1)
        return
        Service -> InvDAO : 23.7 : resolveItem(conn, itemId,\n"Created lost incident #{incidentId}",\nlibrarianId)
        return
        Service -> AuditDAO : 23.8 : insert(conn, librarianId,\n"CREATE_INCIDENT_FROM_INVENTORY",\n"BookCopyIncident", incidentId, ...)
        return
        note over Service : COMMIT Transaction
    end
end

== PHASE 6 — Complete Inventory Session ==

Librarian -> JSP : 24 : click "Complete Inventory"\n(action=complete)
return
JSP -> Servlet : 25 : doPost [action=complete]
return
Servlet -> Service : 26 : complete(sessionId, librarianId)
note over Service : BEGIN Transaction
Service -> Service : 26.1 : requireSession(conn, id, "reviewing")
return
Service -> InvDAO : 26.2 : countUnresolved(conn, sessionId)

alt 26.2a [unresolved discrepancies remaining]
    InvDAO --> Service : return count > 0
    Service --> Servlet : throw ValidationException\n("Must resolve all discrepancies\nbefore completing")
    Servlet --> JSP : set errorMessage

else 26.2b [all discrepancies resolved]
    InvDAO --> Service : return 0
    Service -> InvDAO : 26.3 : updateSessionStatus\n(conn, id, "reviewing", "completed", librarianId)
    return
    Service -> AuditDAO : 26.4 : insert(conn, librarianId,\n"COMPLETE_INVENTORY_SESSION",\n"InventorySession", sessionId, ...)
    return
    note over Service : COMMIT Transaction
    Service --> Servlet : return void
    Servlet -> Librarian : 27 : sendRedirect\n("?success=completed")
end
@enduml
