@startuml Flow_3_3_4_BulkBookImport
autoactivate on

actor Librarian
participant "book-import.jsp" as JSP
participant "book-import-preview.jsp" as Preview
participant "AuthFilter" as Filter
participant "BookImportServlet" as Servlet
participant "BookImportService" as Service
participant "BookImportValidator" as Validator
participant "BookDAO" as BDAO
participant "BookCopyDAO" as BCDAO
participant "BookImportDAO" as ImportDAO
participant "AuditLogDAO" as AuditDAO

note over Librarian, AuditDAO : PHASE 1 — Validation & Preview

Librarian -> JSP : 1 : upload .xlsx file (action=upload)
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doPost(request, response) [action=upload]
return
Servlet -> Service : 4 : validateAndPreview(xlsxFile, librarianId)
Service -> Service : 4.1 : BookImportWorkbookReader.readRows(file)
return

alt 4.1a [invalid file format / size > 10MB]
    Service --> Servlet : throw Exception(...)
    Servlet --> JSP : set errorMessage, forward

else 4.1b [validation errors detected]
    Service -> Validator : 4.2 : validate(rowDTO) for each row
    Validator -> BDAO : findByIsbn(isbn)
    return
    Validator --> Service : return List<BookImportError>
    Service --> Servlet : return errors
    Servlet --> JSP : display "Row N: {field} — {error}"

else 4.1c [all rows valid]
    Service -> Validator : 4.2 : validate(rowDTO) for each row
    return
    Service --> Servlet : return List<BookImportPreviewDTO>
    Servlet -> Servlet : 5 : session.setAttribute\n("bookImportPreview", previewList)
    return
    Servlet --> Preview : forward book-import-preview.jsp
    Preview --> Librarian : display preview for confirmation
end

note over Librarian, AuditDAO : PHASE 2 — Commit

Librarian -> Preview : 6 : click "Confirm" (action=confirm)
return
Preview -> Filter : 7 : doFilter(request, response, chain)
return
Filter -> Servlet : 8 : doPost(request, response) [action=confirm]
return
Servlet -> Servlet : 9 : session.getAttribute("bookImportPreview")
return
Servlet -> Service : 10 : commitImport(previewList, librarianId)
Service -> ImportDAO : 10.1 : insertBatch\n(status='processing', importedBy=librarianId)
return

loop Each BookImportPreviewDTO
    Service -> BDAO : 10.2 : createBook(book, categoryIds[], tagIds[])
    return
    Service -> BCDAO : 10.3 : insertBookCopy × quantity\n(auto-gen barcode "LMS{bookId}{seq}")
    return
end

note right of Service : All-or-Nothing Transaction (BR-27)

alt 10a [SQLException - ROLLBACK]
    Service -> ImportDAO : updateBatch(status='failed')
    return
    Service --> Servlet : throw DatabaseException(...)
    Servlet --> JSP : set errorMessage = "System error, transaction rolled back"

else 10b [COMMIT successful]
    Service -> ImportDAO : 10.4 : updateBatch\n(status='completed', successRows, failedRows)
    return
    Service -> AuditDAO : 10.5 : insertAuditLog(librarianId,\n"BOOK_IMPORT", "BookImportBatch",\nbatchId, null, stats)
    return
    Service --> Servlet : return {successRows, totalRows}
    Servlet -> Librarian : 11 : sendRedirect("?success=imported&count=N")
end
@enduml
