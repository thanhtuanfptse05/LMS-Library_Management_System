@startuml Flow_3_8_2_NotificationManagement
autoactivate on

actor Manager as "Library Manager"
participant "manage-notifications.jsp" as JSP
participant "AuthFilter" as Filter
participant "NotificationManagerServlet" as Servlet
participant "NotificationDAO" as NotiDAO
participant "DocumentTempDAO" as TempDAO
participant "AuditLogDAO" as AuditDAO

== View Notification List ==

Manager -> JSP : 1 : open "Notification Management" page
return
JSP -> Filter : 2 : doFilter(request, response, chain)
return
Filter -> Servlet : 3 : doGet(request, response)
return
Servlet -> Servlet : 3.1 : isAuthorizedManager(request, response)
return
Servlet -> NotiDAO : 4 : countFiltered(keyword, typeFilter)
return
Servlet -> NotiDAO : 4.1 : getAllPaged(keyword, typeFilter, page, PAGE_SIZE)
return
Servlet -> TempDAO : 4.2 : getAll()
note right : Load email template list\nfor JSP dropdown rendering
return
Servlet --> JSP : 5 : forward manage-notifications.jsp\nwith {notifications[], totalPages,\nemailTemplates[]}
JSP --> Manager : display notification list\n+ Create / Edit / Delete buttons

== Create New Notification ==

Manager -> JSP : 6 : fill form (title, content, type,\ntargetRole, isPinned, thumbnailUrl)\n& submit (action=create)
return
JSP -> Filter : 7 : doFilter(request, response, chain)
return
Filter -> Servlet : 8 : doPost(request, response) [action=create]
return
Servlet -> Servlet : 8.1 : handleCreate(request, response, managerId)
return

alt 8.1a [title or content empty]
    Servlet --> JSP : set errorMessage\n"Title and content cannot be empty"

else 8.1b [valid data]
    Servlet -> NotiDAO : 9 : insertNotification(notification)
    note right : INSERT Notification\n(title, content, type, targetRole,\nisPinned, thumbnailUrl, createdBy, NOW())
    return
    Servlet -> AuditDAO : 9.1 : insertAuditLog(managerId,\n"CREATE_NOTIFICATION", "Notification",\nnewId, null, notificationJson)
    return
    Servlet -> Manager : 10 : sendRedirect\n("/manager/notifications?success=created")
end

== Update Notification ==

Manager -> JSP : 11 : click "Edit" → load edit form\n→ update content, submit (action=update)
return
JSP -> Filter : 12 : doFilter(request, response, chain)
return
Filter -> Servlet : 13 : doPost(request, response) [action=update]
return
Servlet -> Servlet : 13.1 : handleUpdate(request, response, managerId)
return
Servlet -> NotiDAO : 14 : findById(notificationId)
return

alt 14a [notification not found]
    NotiDAO --> Servlet : return null
    Servlet --> JSP : set errorMessage "Notification does not exist"

else 14b [notification found]
    Servlet -> NotiDAO : 15 : updateNotification(notification)
    note right : UPDATE Notification\nSET title=?, content=?, type=?,\ntargetRole=?, isPinned=?,\nthumbnailUrl=?, updatedAt=NOW()
    return
    Servlet -> AuditDAO : 15.1 : insertAuditLog(managerId,\n"UPDATE_NOTIFICATION", "Notification",\nnotificationId, oldValues, newValues)
    return
    Servlet -> Manager : 16 : sendRedirect\n("/manager/notifications?success=updated")
end

== Delete Notification (Soft-delete) ==

Manager -> JSP : 17 : click "Delete" (action=delete)
return
JSP -> Filter : 18 : doFilter(request, response, chain)
return
Filter -> Servlet : 19 : doPost(request, response) [action=delete]
return
Servlet -> Servlet : 19.1 : handleDelete(request, response, managerId)
return
Servlet -> NotiDAO : 20 : deleteNotification(notificationId)
note right : DELETE Notification\nWHERE notificationId=?\n(+ CASCADE UserNotificationStatus)
return
Servlet -> AuditDAO : 20.1 : insertAuditLog(managerId,\n"DELETE_NOTIFICATION", "Notification",\nnotificationId, oldValues, null)
return
Servlet -> Manager : 21 : sendRedirect\n("/manager/notifications?success=deleted")
@enduml
