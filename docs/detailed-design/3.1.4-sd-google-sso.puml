@startuml Flow_3_1_4_GoogleSSOLogin
autoactivate on

actor User
participant "AuthFilter" as Filter
participant "GoogleLoginServlet" as Servlet
participant "GoogleOAuth\n(GoogleSSOUtil)" as Google
participant "UserDAO" as DAO
participant "AuthService" as Service
participant "MemberProfileDAO" as ProfDAO

User -> Filter : 1 : GET /auth/google (click Google button)
return
Filter -> Servlet : 2 : doGet(request, response)
return
Servlet -> User : 3 : sendRedirect(GoogleSSOUtil.getAuthorizationUrl())
User -> Google : 4 : login & grant permission
return
Google -> Servlet : 5 : GET /auth/google/callback?code=...
return
Servlet -> Google : 6 : GoogleSSOUtil.getEmailFromCode(code)
return
Servlet -> DAO : 7 : findByEmail(email)

alt 7a [email DOES NOT exist in LMS - BR-26]
    DAO --> Servlet : return null
    Servlet --> User : sendRedirect("/login?error=notregistered")

else 7b [email exists]
    DAO --> Servlet : return User
    Servlet -> Service : 8 : isLockedOnlyForUnpaid(userId)
    return

    alt 8a [account locked - adminban/securitybreach]
        opt 8a.1 [lockedUntil <= NOW()]
            Servlet -> DAO : unlockAccount(userId)
            return
        end
        Servlet --> User : sendRedirect("/login?error=locked")

    else 8b [active account or locked only for unpaid]
        Servlet -> ProfDAO : 9 : findByUserId(userId)
        return
        Servlet -> Servlet : 10 : session.setAttribute\n(userId, role, email, fullName)
        return
        opt 10a [isLockedOnlyForUnpaid = true]
            Servlet -> Servlet : session.setAttribute("unpaidWarning", true)
            return
        end
        Servlet -> User : 11 : sendRedirect(getRedirectByRole(role))
    end
end
@enduml
