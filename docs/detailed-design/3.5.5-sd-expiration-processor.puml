@startuml Flow_3_5_5_ExpirationProcessor
autoactivate on

actor System
participant "ReservationExpirationProcessor" as Processor
participant "SystemConfigDAO" as ConfigDAO
participant "ReservationDAO" as ResvDAO
participant "BookCopyDAO" as BCDAO
participant "BookDAO" as BDAO
participant "AuditLogDAO" as AuditDAO
participant "EmailService" as Email

System -> Processor : 1 : run()\n(AppContextListener schedule\nor TriggerReservationExpirationServlet)
return
Processor -> ConfigDAO : 2 : getValue("RESERVATION_HOLD_DAYS")
return
Processor -> ResvDAO : 3 : findExpiredReadyPickup(NOW())
note right : SELECT Reservation\nWHERE status='readypickup'\nAND endDate < NOW()
return

loop Each expired Reservation
    note over Processor : BEGIN Isolated Transaction
    Processor -> ResvDAO : 4 : cancelReservation\n(conn, reservationId,\nreason='Pickup window expired')
    return
    Processor -> ResvDAO : 5 : findNextInQueue(conn, bookId)

    alt 5a [next patron in queue exists]
        ResvDAO --> Processor : return nextReservation
        Processor -> ResvDAO : 5.1 : promoteToReadyPickup\n(nextId, expiredBookCopyId,\nendDate=NOW()+holdDays)
        return
        Processor -> BCDAO : 5.2 : updateStatus(bookCopyId, 'reserved')
        return
        Processor -> Email : 5.3 : enqueue(RESERVATION_READY, nextUserId)
        note right : Asynchronous
        return

    else 5b [no waiting patrons]
        Processor -> BCDAO : 5.1 : updateStatus(bookCopyId, 'available')
        return
        Processor -> BDAO : 5.2 : incrementAvailableQuantity(bookId)
        return
    end

    Processor -> AuditDAO : 6 : insertAuditLog(null,\n"CANCEL_EXPIRED_RESERVATION",\n"Reservation", reservationId, ...)
    return
    note over Processor : COMMIT Transaction
    Processor -> Email : 7 : enqueue(RESERVATION_EXPIRED_NOTICE,\noriginalUserId)
    note right : Asynchronous
    return
end

Processor --> System : 8 : return {processedCount,\ncancelledCount, reassignedCount}
@enduml
