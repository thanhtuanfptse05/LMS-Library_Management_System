# .agentignore — Files agent không đọc để tối ưu token và bảo mật
# Các tệp trong danh sách này AI Agent KHÔNG được đọc trừ khi được yêu cầu trực tiếp từ Human

# Build artifacts (Java/NetBeans)
target/
build/
dist/
*.class
*.war
*.ear
*.jar
*.exe
*.dll
*.so

# Dependencies
node_modules/
vendor/
lib/
web/WEB-INF/lib/  # Thư viện ngoài jar không cần đọc code internals

# IDE config & Project Settings
.vscode/
.idea/
.settings/
.classpath
.project
.nbproject/      # Cấu hình dự án NetBeans
nbproject/
*.swp
*.swo

# Version control
.git/
.gitignore

# Logs và debug
*.log
logs/
tmp/
temp/
coverage/

# Binary & Media files
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.pdf
*.zip
*.tar.gz

# Secrets & Credentials (Bảo mật tuyệt đối theo hiến pháp)
.env
.env.*
*.pem
*.key
*.secret
credentials/
secrets/
